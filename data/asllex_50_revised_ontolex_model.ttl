data:entry-angry
    a ontolex:LexicalEntry, aslkg:SignLexicalEntry ;
    dct:identifier "angry" ;
    ontolex:evokes data:concept-angry ;
    ontolex:lexicalForm data:form-angry ;
    vartrans:translatableAs data:entry-angry-en ;
    lexinfo:partOfSpeech lexinfo:adjective ;
    aslkg:semanticField data:semantic-field-emotion ;
    aslkg:frequency "4.96"^^xsd:decimal ;
    aslkg:nonSignerIconicity "2.741"^^xsd:decimal ;
    foaf:page <https://asl-lex.org/visualization/?sign=angry> ;
    prov:wasDerivedFrom data:asl-lex-50-dataset .

data:form-angry
    a ontolex:Form, aslkg:SignForm ;
    aslkg:signType data:sign-type-symmetrical-or-alternating ;
    aslkg:dominantHandshape data:handshape-5 ;
    aslkg:nondominantHandshape data:handshape-5 ;
    aslkg:selectedFingerConfiguration data:selected-fingers-imrp ;
    aslkg:numberOfSelectedFingers 4 ;
    aslkg:indexSelected true ;
    aslkg:middleSelected true ;
    aslkg:ringSelected true ;
    aslkg:pinkySelected true ;
    aslkg:thumbSelected false ;
    aslkg:thumbPosition data:thumb-position-open ;
    aslkg:pathMovement data:path-movement-curved ;
    aslkg:repeatedMovement false ;
    aslkg:majorLocation data:major-location-body ;
    aslkg:minorLocation data:minor-location-torso-top ;
    aslkg:contact true ;
    aslkg:phonologicalComplexity 2 ;
    aslkg:neighborhoodDensity 1  .

