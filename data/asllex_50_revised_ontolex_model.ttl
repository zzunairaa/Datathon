@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lime:    <http://www.w3.org/ns/lemon/lime#> .
@prefix vartrans:<http://www.w3.org/ns/lemon/vartrans#> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

@prefix aslkg:   <https://w3id.org/asl-lex-kg/ontology#> .
@prefix data:    <https://w3id.org/asl-lex-kg/resource/> .

#################################################################
# ASL-LEX KG ontology
#################################################################

<https://w3id.org/asl-lex-kg/ontology>
    a owl:Ontology ;
    dct:title "ASL-LEX Knowledge Graph Vocabulary"@en ;
    dct:description "Ontology for the curated 50-entry ASL-LEX dataset. Entry IDs are OntoLex lexical entries, shared Lemma IDs are OntoLex lexical concepts evoked by entries, and phonological information is represented on OntoLex forms."@en .

aslkg:SignLexicalEntry
    a owl:Class ;
    rdfs:label "ASL lexical entry"@en ;
    rdfs:subClassOf ontolex:LexicalEntry .

aslkg:SignForm
    a owl:Class ;
    rdfs:label "ASL sign form"@en ;
    rdfs:subClassOf ontolex:Form .

aslkg:SemanticField
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "ASL-LEX semantic field"@en .

aslkg:SignType
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "sign type"@en .

aslkg:Handshape
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "handshape"@en .

aslkg:SelectedFingerConfiguration
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "selected finger configuration"@en .

aslkg:ThumbPosition
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "thumb position"@en .

aslkg:PathMovement
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "path movement"@en .

aslkg:MajorLocation
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "major location"@en .

aslkg:MinorLocation
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "minor location"@en .

aslkg:NondominantHandConfigurationStatus
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "nondominant hand configuration status"@en .

aslkg:semanticField
    a owl:ObjectProperty ;
    rdfs:domain aslkg:SignLexicalEntry ;
    rdfs:range aslkg:SemanticField ;
    rdfs:label "semantic field"@en .

aslkg:signType
    a owl:ObjectProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range aslkg:SignType ;
    rdfs:label "sign type"@en .

aslkg:dominantHandshape
    a owl:ObjectProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range aslkg:Handshape ;
    rdfs:label "dominant handshape"@en .

aslkg:nondominantHandshape
    a owl:ObjectProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range aslkg:Handshape ;
    rdfs:label "nondominant handshape"@en .

aslkg:nondominantHandConfigurationStatus
    a owl:ObjectProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range aslkg:NondominantHandConfigurationStatus ;
    rdfs:label "nondominant hand configuration status"@en .

aslkg:selectedFingerConfiguration
    a owl:ObjectProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range aslkg:SelectedFingerConfiguration ;
    rdfs:label "selected finger configuration"@en .

aslkg:thumbPosition
    a owl:ObjectProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range aslkg:ThumbPosition ;
    rdfs:label "thumb position"@en .

aslkg:pathMovement
    a owl:ObjectProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range aslkg:PathMovement ;
    rdfs:label "path movement"@en .

aslkg:majorLocation
    a owl:ObjectProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range aslkg:MajorLocation ;
    rdfs:label "major location"@en .

aslkg:minorLocation
    a owl:ObjectProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range aslkg:MinorLocation ;
    rdfs:label "minor location"@en .

aslkg:numberOfSelectedFingers
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range xsd:integer ;
    rdfs:label "number of selected fingers"@en .

aslkg:indexSelected
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range xsd:boolean ;
    rdfs:label "index finger selected"@en .

aslkg:middleSelected
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range xsd:boolean ;
    rdfs:label "middle finger selected"@en .

aslkg:ringSelected
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range xsd:boolean ;
    rdfs:label "ring finger selected"@en .

aslkg:pinkySelected
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range xsd:boolean ;
    rdfs:label "pinky finger selected"@en .

aslkg:thumbSelected
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range xsd:boolean ;
    rdfs:label "thumb selected"@en .

aslkg:repeatedMovement
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range xsd:boolean ;
    rdfs:label "repeated movement"@en .

aslkg:contact
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range xsd:boolean ;
    rdfs:label "contact"@en .

aslkg:frequency
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignLexicalEntry ;
    rdfs:range xsd:decimal ;
    rdfs:label "frequency"@en .

aslkg:nonSignerIconicity
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignLexicalEntry ;
    rdfs:range xsd:decimal ;
    rdfs:label "non-signer iconicity"@en .

aslkg:phonologicalComplexity
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range xsd:integer ;
    rdfs:label "phonological complexity"@en .

aslkg:neighborhoodDensity
    a owl:DatatypeProperty ;
    rdfs:domain aslkg:SignForm ;
    rdfs:range xsd:integer ;
    rdfs:label "phonological neighborhood density"@en .

#################################################################
# Controlled vocabularies
#################################################################

data:semantic-field-scheme a skos:ConceptScheme ; skos:prefLabel "ASL-LEX semantic fields"@en .
data:sign-type-scheme a skos:ConceptScheme ; skos:prefLabel "ASL-LEX sign types"@en .
data:handshape-scheme a skos:ConceptScheme ; skos:prefLabel "ASL-LEX handshapes"@en .
data:selected-finger-scheme a skos:ConceptScheme ; skos:prefLabel "ASL-LEX selected finger configurations"@en .
data:thumb-position-scheme a skos:ConceptScheme ; skos:prefLabel "ASL-LEX thumb positions"@en .
data:path-movement-scheme a skos:ConceptScheme ; skos:prefLabel "ASL-LEX path movements"@en .
data:major-location-scheme a skos:ConceptScheme ; skos:prefLabel "ASL-LEX major locations"@en .
data:minor-location-scheme a skos:ConceptScheme ; skos:prefLabel "ASL-LEX minor locations"@en .
data:nondominant-status-scheme a skos:ConceptScheme ; skos:prefLabel "ASL-LEX nondominant hand configuration statuses"@en .

data:part-of-speech-minor
    a skos:Concept ;
    skos:prefLabel "Minor"@en ;
    skos:notation "Minor" .

#################################################################
# Lexicons and source dataset
#################################################################

data:asl-lex-lexicon
    a lime:Lexicon ;
    dct:title "ASL-LEX 2.0 curated 50-entry lexicon"@en ;
    lime:language "ase" ;
    dct:source <https://asl-lex.org/> ;
    lime:entry data:entry-angry,
        data:entry-bird,
        data:entry-boss,
        data:entry-corn-2,
        data:entry-dinosaur,
        data:entry-duck,
        data:entry-engineer,
        data:entry-happy,
        data:entry-inside,
        data:entry-italy,
        data:entry-japan,
        data:entry-lobster,
        data:entry-mouse,
        data:entry-nephew,
        data:entry-new-york,
        data:entry-next-to,
        data:entry-one,
        data:entry-onion,
        data:entry-over,
        data:entry-philadelphia,
        data:entry-potato,
        data:entry-russia-2,
        data:entry-sad,
        data:entry-spaghetti,
        data:entry-squirrel,
        data:entry-straight,
        data:entry-strawberry,
        data:entry-strawberry-2,
        data:entry-strong,
        data:entry-stupid-1,
        data:entry-stupid-2,
        data:entry-sushi,
        data:entry-sweep,
        data:entry-third-1,
        data:entry-third-2,
        data:entry-three,
        data:entry-tiger,
        data:entry-twins-1,
        data:entry-twins-2,
        data:entry-two,
        data:entry-under,
        data:entry-vacuum,
        data:entry-vegetable,
        data:entry-waiter,
        data:entry-wander,
        data:entry-wet,
        data:entry-witch,
        data:entry-wrong-1,
        data:entry-wrong-2,
        data:entry-zoom-in .

data:english-stub-lexicon
    a lime:Lexicon ;
    dct:title "Minimal English translation stubs for the ASL-LEX pilot"@en ;
    lime:language "en" ;
    lime:entry data:entry-angry-en,
        data:entry-bird-en,
        data:entry-boss-en,
        data:entry-corn-en,
        data:entry-dinosaur-en,
        data:entry-duck-en,
        data:entry-engineer-en,
        data:entry-happy-en,
        data:entry-inside-en,
        data:entry-italy-en,
        data:entry-japan-en,
        data:entry-lobster-en,
        data:entry-mouse-en,
        data:entry-nephew-en,
        data:entry-new-york-en,
        data:entry-next-to-en,
        data:entry-one-en,
        data:entry-onion-en,
        data:entry-over-en,
        data:entry-philadelphia-en,
        data:entry-potato-en,
        data:entry-russia-en,
        data:entry-sad-en,
        data:entry-spaghetti-en,
        data:entry-squirrel-en,
        data:entry-straight-en,
        data:entry-strawberry-en,
        data:entry-strong-en,
        data:entry-stupid-en,
        data:entry-sushi-en,
        data:entry-sweep-en,
        data:entry-third-en,
        data:entry-three-en,
        data:entry-tiger-en,
        data:entry-twins-en,
        data:entry-two-en,
        data:entry-under-en,
        data:entry-vacuum-en,
        data:entry-vegetable-en,
        data:entry-waiter-en,
        data:entry-wander-en,
        data:entry-wet-en,
        data:entry-witch-en,
        data:entry-wrong-en,
        data:entry-zoom-in-en .

data:asl-lex-50-dataset
